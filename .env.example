# Standalone Go API: http://127.0.0.1:8081
API_BIND=127.0.0.1
API_PORT=8081
API_LANGUAGE=auto
API_TOKEN_TTL=1h

# Operator restrictions apply to new API commands; existing signed S3 URLs keep
# their own expiry. Reading and safe cancellation remain available.
API_READ_ONLY=false
API_DISABLE_UPLOADS=false
API_DISABLE_DELETES=false
API_DISABLE_ADMIN_CHANGES=false

# Select memory, sqlite, postgres or mysql. Generate the keyring before a
# persistent startup: make docker-build state-init
API_DB_DRIVER=sqlite
API_DB_HOST=127.0.0.1
# Empty selects 5432 for PostgreSQL or 3306 for MySQL.
API_DB_PORT=
API_DB_NAME=
API_DB_USER=
API_DB_PASSWORD=
API_DB_SQLITE_PATH=/var/lib/api/state.db
# Network databases: verify-full (default) or disable for local test fixtures.
API_DB_TLS_MODE=verify-full
API_DB_TLS_CA_FILE=
API_STATE_KEYRING_FILE=/run/api-state/keyring.json
API_DB_MAX_OPEN=10
API_DB_MAX_IDLE=2
API_DB_CONN_LIFETIME=30m

# Set the external browser origin when behind a reverse proxy.
APP_ORIGIN=
MINIO_ALLOWED_ENDPOINTS=
# Example: {"http://localhost:9000":"http://host.docker.internal:9000"}
MINIO_ENDPOINT_OVERRIDES=

API_MAX_TRANSFERS=4
API_MAX_TRANSFERS_PER_SESSION=2
API_MAX_LOGINS=8
API_LOGIN_BURST=60
API_LOGIN_REFILL=1s
API_TEMPORARY_BYTES=2147483648
API_TRUSTED_PROXIES=
API_CONDITIONAL_DELETE_ENDPOINTS=
API_CONDITIONAL_COMPLETE_ENDPOINTS=
